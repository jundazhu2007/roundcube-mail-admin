# Copy this file to /etc/mail-admin.env (or wherever your systemd EnvironmentFile points)
# and fill in real values. Never commit the filled-in file.

# --- Break-glass admin account (bootstraps the first super_admin on first run) ---
# Generate the hash with:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
MAIL_ADMIN_USER=admin
MAIL_ADMIN_PASS_HASH=

# --- JWT signing secret for admin session tokens ---
# Generate with: openssl rand -hex 32
MAIL_ADMIN_JWT_SECRET=

# --- Mail server database (vmail-style users/domains schema) ---
MAIL_ADMIN_DB_HOST=127.0.0.1
MAIL_ADMIN_DB_USER=mailuser
MAIL_ADMIN_DB_PASS=
MAIL_ADMIN_DB_NAME=mailserver

# --- Default domain pre-filled when creating a new mailbox user ---
MAIL_ADMIN_DEFAULT_DOMAIN=example.com

# --- Optional: override default file/log paths (only if your mail stack differs) ---
# MAIL_ADMIN_LOG_PATH=/var/log/mail.log
# MAIL_ADMIN_MAILDATA_PATH=/mnt/maildata/homes
# MAIL_ADMIN_AMAVIS_OVERRIDE_FILE=/etc/amavis/conf.d/50-user
# MAIL_ADMIN_IP_WHITELIST_FILE=/etc/mail-admin/whitelist-ips.txt
# MAIL_ADMIN_IP_BLACKLIST_FILE=/etc/mail-admin/blacklist-ips.txt
# MAIL_ADMIN_TOKEN_EXPIRE_MINUTES=480

# --- WebAuthn / Passkey login ---
# RP_ID must match the hostname the admin panel is served on (no scheme, no port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=NannanCat Mail Admin
WEBAUTHN_ORIGIN=http://localhost:5173
